# OMOI Mini: ausschließlich Variablennamen, niemals echte Schlüsselwerte.
# Zugangsdaten später in der Windows-Benutzerumgebung setzen.
# Dieses Beispiel enthält bewusst nur leere Felder.
OPENAI_API_KEY=
CARTESIA_API_KEY=
# Optionale, ausschließlich lokale Endpunkte; die Anwendung muss diese validieren.
OMOI_MINI_LLM_ENDPOINT=
OMOI_MINI_TTS_ENDPOINT=
# Optionales Verzeichnis für lokale Benutzerdaten.
OMOI_MINI_DATA_DIR=

# Optional: Verzeichnis des separat installierten lokalen STT-/TTS-Workerverzeichnisses.
# Persönliche Schlüsselwerte gehören NICHT in diese Beispiel-Datei.
OMOI_MINI_RUNTIME_ROOT=

# Für die unabhängige portable Cartesia-Stimme separat setzen (niemals echte IDs einchecken).
CARTESIA_VOICE_ID=

# Eigenes OpenVINO-Whisper-Modell für die unabhängige Portable-EXE.
# Die Portable-EXE liest absichtlich KEIN Modell aus der großen OMOI.
OMOI_MINI_STT_MODEL=

# Optionale getrennte Python-Laufzeiten und CUDA-STT-Modellpfade.
# Nur lokal gesetzte absolute Pfade verwenden; keine Werte einchecken.
OMOI_MINI_CUDA_STT_PYTHON=
OMOI_MINI_CUDA_STT_OVERLAY=
OMOI_MINI_CUDA_STT_MODEL=
OMOI_MINI_QWEN_PYTHON=
OMOI_MINI_PIPER_PYTHON=
